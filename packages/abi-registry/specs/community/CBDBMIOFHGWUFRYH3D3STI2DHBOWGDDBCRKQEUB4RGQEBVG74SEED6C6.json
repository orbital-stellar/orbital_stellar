  "name": "Axelar Interchain Token Service",
  "network": "mainnet",
  "types": {
    "CommandType": {
      "cases": [
        { "fields": [], "name": "ApproveMessages" },
        { "fields": [], "name": "RotateSigners" }
      ],
      "kind": "union",
      "name": "CommandType"
    },
    "ContractError": {
      "kind": "enum",
      "name": "ContractError",
      "variants": [
        { "discriminant": 1, "name": "MigrationNotAllowed" },
        { "discriminant": 2, "name": "MigrationInProgress" }
      ]
    },
    "Message": {
      "fields": [
        { "name": "contract_address", "type": "address" },
        { "name": "message_id", "type": "string" },
        { "name": "payload_hash", "type": { "size": 32, "type": "bytes_n" } },
        { "name": "source_address", "type": "string" },
        { "name": "source_chain", "type": "string" }
      ],
      "kind": "struct",
      "name": "Message"
    },
    "Proof": {
      "doc": "`Proof` represents a proof that a set of signers have signed a message.\nAll weighted signers are included in the along with a signature, if they have signed the message,\nuntil threshold is met.",
      "fields": [
        { "name": "nonce", "type": { "size": 32, "type": "bytes_n" } },
        {
          "name": "signers",
          "type": { "item": { "name": "ProofSigner", "type": "named" }, "type": "vec" }
        },
        { "name": "threshold", "type": "u128" }
      ],
      "kind": "struct",
      "name": "Proof"
    },
    "ProofSignature": {
      "cases": [
        {
          "fields": [{ "name": "_0", "type": { "size": 64, "type": "bytes_n" } }],
          "name": "Signed"
        },
        { "fields": [], "name": "Unsigned" }
      ],
      "doc": "`ProofSignature` represents an optional signature from a signer.\nSince Soroban doesn't support use of `Option` in it's contract interfaces,\nwe use this enum instead.",
      "kind": "union",
      "name": "ProofSignature"
    },
    "ProofSigner": {
      "doc": "`ProofSigner` represents a signer in a proof.\n\nIf the signer submitted a signature, and if it is being included in the proof to meet the threshold,\nthen a signature is attached. Otherwise, the `ProofSignature` is `Unsigned`.",
      "fields": [
        { "name": "signature", "type": { "name": "ProofSignature", "type": "named" } },
        { "name": "signer", "type": { "name": "WeightedSigner", "type": "named" } }
      ],
      "kind": "struct",
      "name": "ProofSigner"
    },
    "RecoveryMigrationData": {
      "doc": "Input to the recovery `__migrate` above. Carries the token-specific values\nthat would otherwise have to be hardcoded per-network, letting the same\nmigration body run on devnet/testnet (with a fabricated repro token) and\nmainnet (with wXRP: token_id `0xba5a21ca…2824f`, \"Wrapped XRP\" / \"wXRP\" / 6).\n\nFields are kept alphabetically ordered because `#[contracttype]` serializes\nstructs as ScVal maps with sorted keys — keeping the source order matched\nmakes the encoding deterministic and easier to inspect.",
      "fields": [
        { "name": "token_decimals", "type": "u32" },
        { "name": "token_id", "type": { "size": 32, "type": "bytes_n" } },
        { "name": "token_name", "type": "string" },
        { "name": "token_symbol", "type": "string" }
      ],
      "kind": "struct",
      "name": "RecoveryMigrationData"
    },
    "Token": {
      "fields": [
        { "name": "address", "type": "address" },
        { "name": "amount", "type": "i128" }
      ],
      "kind": "struct",
      "name": "Token"
    },
    "TokenIdConfigValue": {
      "fields": [
        { "name": "token_address", "type": "address" },
        { "name": "token_manager", "type": "address" },
        { "name": "token_manager_type", "type": { "name": "TokenManagerType", "type": "named" } }
      ],
      "kind": "struct",
      "name": "TokenIdConfigValue"
    },
    "TokenManagerType": {
      "doc": "The type of token manager used for the tokenId.\n\nOnly the variants supported by Stellar ITS are defined here.\nThe variant values need to match the [ITS spec](https://github.com/axelarnetwork/interchain-token-service/blob/v2.0.0/contracts/interfaces/ITokenManagerType.sol#L9).",
      "kind": "enum",
      "name": "TokenManagerType",
      "variants": [
        { "discriminant": 0, "name": "NativeInterchainToken" },
        { "discriminant": 1, "name": "MintBurnFrom" },
        { "discriminant": 2, "name": "LockUnlock" },
        { "discriminant": 4, "name": "MintBurn" }
      ]
    },
    "TokenMetadata": {
      "fields": [
        { "name": "decimal", "type": "u32" },
        { "name": "name", "type": "string" },
        { "name": "symbol", "type": "string" }
      ],
      "kind": "struct",
      "name": "TokenMetadata"
    },
    "WeightedSigner": {
      "fields": [
        { "name": "signer", "type": { "size": 32, "type": "bytes_n" } },
        { "name": "weight", "type": "u128" }
      ],
      "kind": "struct",
      "name": "WeightedSigner"
    },
    "WeightedSigners": {
      "fields": [
        { "name": "nonce", "type": { "size": 32, "type": "bytes_n" } },
        {
          "name": "signers",
          "type": { "item": { "name": "WeightedSigner", "type": "named" }, "type": "vec" }
        },
        { "name": "threshold", "type": "u128" }
      ],
      "kind": "struct",
      "name": "WeightedSigners"
    }
  },
