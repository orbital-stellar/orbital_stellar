{
  "contractId": "CDQBHEUGLDHMSUHG4IH33RJBUTMNCZOT4JIAQR4WZFRDZW6DR6S32ZLZ",
  "description": "Chainlink Data Feeds proxy contract on Stellar mainnet: the single read entry point for every Chainlink price feed on Stellar. Callers pass a feed data_id (e.g. XLM/USD, BTC/USD) to latest_round, get_round, decimals or description, and the proxy reads the round from its backing DataFeedsCache contract. Lending, prediction-market and perps protocols on Stellar consume Chainlink prices through it.",
  "events": [
    {
      "data": [
        { "name": "old_cache", "type": "address" },
        { "name": "new_cache", "type": "address" }
      ],
      "name": "CacheSet",
      "topics": [
        {
          "doc": "Fixed prefix topic, always \"CacheSet\".",
          "name": "event_name",
          "type": "symbol"
        }
      ]
    },
    {
      "data": [{ "name": "min", "type": "u32" }],
      "name": "MinDecimalsSet",
      "topics": [
        {
          "doc": "Fixed prefix topic, always \"MinDecimalsSet\".",
          "name": "event_name",
          "type": "symbol"
        },
        { "name": "data_id", "type": { "size": 32, "type": "bytes_n" } }
      ]
    },
    {
      "data": [{ "name": "new_wasm_hash", "type": { "size": 32, "type": "bytes_n" } }],
      "name": "Upgraded",
      "topics": [
        {
          "doc": "Fixed prefix topic, always \"Upgraded\".",
          "name": "event_name",
          "type": "symbol"
        }
      ]
    },
    {
      "data": [
        { "name": "token", "type": "address" },
        { "name": "to", "type": "address" },
        { "name": "amount", "type": "i128" }
      ],
      "name": "TokenRecovered",
      "topics": [
        {
          "doc": "Fixed prefix topic, always \"TokenRecovered\".",
          "name": "event_name",
          "type": "symbol"
        }
      ]
    },
    {
      "data": [
        { "name": "old_owner", "type": "address" },
        { "name": "new_owner", "type": "address" },
        { "name": "live_until_ledger", "type": "u32" }
      ],
      "doc": "Event emitted when an ownership transfer is initiated.",
      "name": "OwnershipTransfer",
      "topics": [
        {
          "doc": "Fixed prefix topic, always \"ownership_transfer\".",
          "name": "event_name",
          "type": "symbol"
        }
      ]
    },
    {
      "data": [{ "name": "old_owner", "type": "address" }],
      "doc": "Event emitted when ownership is renounced.",
      "name": "OwnershipRenounced",
      "topics": [
        {
          "doc": "Fixed prefix topic, always \"ownership_renounced\".",
          "name": "event_name",
          "type": "symbol"
        }
      ]
    },
    {
      "data": [{ "name": "new_owner", "type": "address" }],
      "doc": "Event emitted when an ownership transfer is completed.",
      "name": "OwnershipTransferCompleted",
      "topics": [
        {
          "doc": "Fixed prefix topic, always \"ownership_transfer_completed\".",
          "name": "event_name",
          "type": "symbol"
        }
      ]
    }
  ],
  "functions": [
    {
      "name": "upgrade",
      "params": [{ "name": "new_wasm_hash", "type": { "size": 32, "type": "bytes_n" } }],
      "returns": "void"
    },
    { "name": "version", "params": [], "returns": "u32" },
    {
      "name": "decimals",
      "params": [{ "name": "data_id", "type": { "size": 32, "type": "bytes_n" } }],
      "returns": {
        "err": { "name": "ProxyReadError", "type": "named" },
        "ok": "u32",
        "type": "result"
      }
    },
    { "name": "get_cache", "params": [], "returns": "address" },
    {
      "doc": "Returns `Some(Address)` if ownership is set, or `None` if ownership has\nbeen renounced.\n\n# Arguments\n\n* `e` - Access to the Soroban environment.",
      "name": "get_owner",
      "params": [],
      "returns": { "inner": "address", "type": "option" }
    },
    {
      "name": "get_round",
      "params": [
        { "name": "data_id", "type": { "size": 32, "type": "bytes_n" } },
        { "name": "round_id", "type": "u64" },
        { "name": "decimals", "type": "u32" }
      ],
      "returns": {
        "err": { "name": "ProxyReadError", "type": "named" },
        "ok": { "name": "Round", "type": "named" },
        "type": "result"
      }
    },
    { "name": "set_cache", "params": [{ "name": "cache", "type": "address" }], "returns": "void" },
    {
      "name": "description",
      "params": [{ "name": "data_id", "type": { "size": 32, "type": "bytes_n" } }],
      "returns": {
        "err": { "name": "ProxyReadError", "type": "named" },
        "ok": "string",
        "type": "result"
      }
    },
    {
      "name": "latest_round",
      "params": [
        { "name": "data_id", "type": { "size": 32, "type": "bytes_n" } },
        { "name": "decimals", "type": "u32" }
      ],
      "returns": {
        "err": { "name": "ProxyReadError", "type": "named" },
        "ok": { "name": "Round", "type": "named" },
        "type": "result"
      }
    },
    {
      "name": "__constructor",
      "params": [
        { "name": "owner", "type": "address" },
        { "name": "cache", "type": "address" }
      ],
      "returns": "void"
    },
    {
      "name": "recover_tokens",
      "params": [
        { "name": "token", "type": "address" },
        { "name": "to", "type": "address" },
        { "name": "amount", "type": "i128" }
      ],
      "returns": "void"
    },
    {
      "doc": "Accepts a pending ownership transfer.\n\n# Arguments\n\n* `e` - Access to the Soroban environment.\n\n# Errors\n\n* [`crate::role_transfer::RoleTransferError::NoPendingTransfer`] - If\nthere is no pending transfer to accept.\n\n# Events\n\n* topics - `[\"ownership_transfer_completed\"]`\n* data - `[new_owner: Address]`",
      "name": "accept_ownership",
      "params": [],
      "returns": "void"
    },
    {
      "name": "get_min_decimals",
      "params": [{ "name": "data_id", "type": { "size": 32, "type": "bytes_n" } }],
      "returns": "u32"
    },
    {
      "name": "set_min_decimals",
      "params": [
        { "name": "data_id", "type": { "size": 32, "type": "bytes_n" } },
        { "name": "min", "type": "u32" }
      ],
      "returns": {
        "err": { "name": "ProxyReadError", "type": "named" },
        "ok": "void",
        "type": "result"
      }
    },
    { "name": "type_and_version", "params": [], "returns": "string" },
    {
      "doc": "Renounces ownership of the contract.\n\nPermanently removes the owner, disabling all functions gated by\n`#[only_owner]`.\n\n# Arguments\n\n* `e` - Access to the Soroban environment.\n\n# Errors\n\n* [`OwnableError::TransferInProgress`] - If there is a pending ownership\ntransfer.\n* [`OwnableError::OwnerNotSet`] - If the owner is not set.\n\n# Notes\n\n* Authorization for the current owner is required.",
      "name": "renounce_ownership",
      "params": [],
      "returns": "void"
    },
    {
      "doc": "Initiates a 2-step ownership transfer to a new address.\n\nRequires authorization from the current owner. The new owner must later\ncall `accept_ownership()` to complete the transfer.\n\n# Arguments\n\n* `e` - Access to the Soroban environment.\n* `new_owner` - The proposed new owner.\n* `live_until_ledger` - Ledger number until which the new owner can\naccept. A value of `0` cancels any pending transfer.\n\n# Errors\n\n* [`OwnableError::OwnerNotSet`] - If the owner is not set.\n* [`crate::role_transfer::RoleTransferError::NoPendingTransfer`] - If\ntrying to cancel a transfer that doesn't exist.\n* [`crate::role_transfer::RoleTransferError::InvalidLiveUntilLedger`] -\nIf the specified ledger is in the past.\n* [`crate::role_transfer::RoleTransferError::InvalidPendingAccount`] -\nIf the specified pending account is not the same as the provided `new`\naddress.\n\n# Notes\n\n* Authorization for the current owner is required.",
      "name": "transfer_ownership",
      "params": [
        { "name": "new_owner", "type": "address" },
        { "name": "live_until_ledger", "type": "u32" }
      ],
      "returns": "void"
    }
  ],
  "name": "Chainlink Data Feeds Proxy",
  "network": "mainnet",
  "types": {
    "CacheError": {
      "kind": "enum",
      "name": "CacheError",
      "variants": [
        { "discriminant": 100, "name": "MalformedReport" },
        { "discriminant": 101, "name": "UnauthorizedCaller" },
        { "discriminant": 102, "name": "FeedNotConfigured" },
        { "discriminant": 103, "name": "EmptyConfig" },
        { "discriminant": 104, "name": "InvalidAddress" },
        { "discriminant": 105, "name": "InvalidWorkflowName" },
        { "discriminant": 106, "name": "DuplicatePermission" },
        { "discriminant": 107, "name": "InvalidDataId" },
        { "discriminant": 108, "name": "DuplicateFeedConfig" },
        { "discriminant": 109, "name": "FeedFrozen" },
        { "discriminant": 110, "name": "NoFeedState" }
      ]
    },
    "OwnableError": {
      "kind": "enum",
      "name": "OwnableError",
      "variants": [
        { "discriminant": 2100, "name": "OwnerNotSet" },
        { "discriminant": 2101, "name": "TransferInProgress" },
        { "discriminant": 2102, "name": "OwnerAlreadySet" }
      ]
    },
    "ProxyReadError": {
      "kind": "enum",
      "name": "ProxyReadError",
      "variants": [
        { "discriminant": 50, "name": "NoDataPresent" },
        { "discriminant": 51, "name": "InvalidDecimals" },
        { "discriminant": 52, "name": "RoundsToZero" }
      ]
    },
    "RoleTransferError": {
      "kind": "enum",
      "name": "RoleTransferError",
      "variants": [
        { "discriminant": 2200, "name": "NoPendingTransfer" },
        { "discriminant": 2201, "name": "InvalidLiveUntilLedger" },
        { "discriminant": 2202, "name": "InvalidPendingAccount" },
        { "discriminant": 2203, "name": "TransferExpired" }
      ]
    },
    "Round": {
      "fields": [
        { "name": "answer", "type": "i256" },
        { "name": "round_id", "type": "u64" },
        { "name": "timestamp", "type": "u64" }
      ],
      "kind": "struct",
      "name": "Round"
    }
  },
  "version": "0.0.0",
