{
  "contractId": "CCQXWMZVM3KRTXTUPTN53YHL272QGKF32L7XEDNZ2S6OSUFK3NFBGG5M",
  "description": "Band Protocol standard reference on Stellar mainnet: the price reference contract that Band relayers write to and that consumers read with get_reference_data.",
  "events": [],
  "functions": [
    {
      "name": "init",
      "params": [
        { "name": "admin_addr", "type": "address" },
        { "name": "instance_threshold", "type": "u32" },
        { "name": "instance_ttl", "type": "u32" },
        { "name": "temporary_threshold", "type": "u32" },
        { "name": "temporary_tll", "type": "u32" }
      ],
      "returns": "void"
    },
    {
      "name": "upgrade",
      "params": [{ "name": "new_wasm_hash", "type": { "size": 32, "type": "bytes_n" } }],
      "returns": "void"
    },
    { "name": "version", "params": [], "returns": "u32" },
    { "name": "current_admin", "params": [], "returns": "address" },
    {
      "name": "transfer_admin",
      "params": [{ "name": "new_admin", "type": "address" }],
      "returns": "void"
    },
    {
      "name": "current_ttl_config",
      "params": [],
      "returns": { "name": "TTLConfig", "type": "named" }
    },
    {
      "name": "update_ttl_config",
      "params": [
        { "name": "instance_threshold", "type": "u32" },
        { "name": "instance_ttl", "type": "u32" },
        { "name": "temporary_threshold", "type": "u32" },
        { "name": "temporary_ttl", "type": "u32" }
      ],
      "returns": "void"
    },
    {
      "name": "is_relayer",
      "params": [{ "name": "address", "type": "address" }],
      "returns": "bool"
    },
    {
      "name": "add_relayers",
      "params": [{ "name": "addresses", "type": { "item": "address", "type": "vec" } }],
      "returns": "void"
    },
    {
      "name": "remove_relayers",
      "params": [{ "name": "addresses", "type": { "item": "address", "type": "vec" } }],
      "returns": "void"
    },
    {
      "name": "relay",
      "params": [
        { "name": "from", "type": "address" },
        {
          "name": "symbol_rates",
          "type": { "item": { "elements": ["symbol", "u64"], "type": "tuple" }, "type": "vec" }
        },
        { "name": "resolve_time", "type": "u64" },
        { "name": "request_id", "type": "u64" }
      ],
      "returns": "void"
    },
    {
      "name": "force_relay",
      "params": [
        {
          "name": "symbol_rates",
          "type": { "item": { "elements": ["symbol", "u64"], "type": "tuple" }, "type": "vec" }
        },
        { "name": "resolve_time", "type": "u64" },
        { "name": "request_id", "type": "u64" }
      ],
      "returns": "void"
    },
    {
      "name": "delist",
      "params": [{ "name": "symbols", "type": { "item": "symbol", "type": "vec" } }],
      "returns": "void"
    },
    {
      "name": "get_ref_data",
      "params": [{ "name": "symbols", "type": { "item": "symbol", "type": "vec" } }],
      "returns": {
        "err": { "name": "StandardReferenceError", "type": "named" },
        "ok": { "item": { "name": "RefDatum", "type": "named" }, "type": "vec" },
        "type": "result"
      }
    },
    {
      "name": "get_reference_data",
      "params": [
        {
          "name": "symbol_pairs",
          "type": { "item": { "elements": ["symbol", "symbol"], "type": "tuple" }, "type": "vec" }
        }
      ],
      "returns": {
        "err": { "name": "StandardReferenceError", "type": "named" },
        "ok": { "item": { "name": "ReferenceDatum", "type": "named" }, "type": "vec" },
        "type": "result"
      }
    }
  ],
  "name": "Band Protocol StandardReference",
  "network": "mainnet",
  "types": {
    "DataKey": {
      "cases": [
        { "fields": [], "name": "Admin" },
        { "fields": [], "name": "TTLConfig" },
        { "fields": [{ "name": "_0", "type": "address" }], "name": "Relayer" },
        { "fields": [{ "name": "_0", "type": "symbol" }], "name": "RefData" }
      ],
      "kind": "union",
      "name": "DataKey"
    },
    "RefDatum": {
      "fields": [
        { "name": "rate", "type": "u64" },
        { "name": "request_id", "type": "u64" },
        { "name": "resolve_time", "type": "u64" }
      ],
      "kind": "struct",
      "name": "RefDatum"
    },
    "ReferenceDatum": {
      "fields": [
        { "name": "last_updated_base", "type": "u64" },
        { "name": "last_updated_quote", "type": "u64" },
        { "name": "rate", "type": "u128" }
      ],
      "kind": "struct",
      "name": "ReferenceDatum"
    },
    "StandardReferenceError": {
      "kind": "enum",
      "name": "StandardReferenceError",
      "variants": [
        { "discriminant": 0, "name": "NotInitializedError" },
        { "discriminant": 1, "name": "NoRefDataError" },
        { "discriminant": 2, "name": "ArithmeticError" }
      ]
    },
    "TTLConfig": {
      "fields": [
        { "name": "instance_threshold", "type": "u32" },
        { "name": "instance_ttl", "type": "u32" },
        { "name": "temporary_threshold", "type": "u32" },
        { "name": "temporary_ttl", "type": "u32" }
      ],
      "kind": "struct",
      "name": "TTLConfig"
    }
  },
  "version": "0.0.0",
