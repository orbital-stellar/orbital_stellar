{
  "contractId": "CACZ3GBAKUPIAFRILUFO27J5RUH5GJ2VSJ46LP6GJYSKGDRTQ5MS3HCH",
  "description": "Pyth Network's Pyth Pro (formerly Pyth Lazer) price feed contract on Stellar mainnet: verifies signed Pyth price updates against the trusted signer set and returns the verified payload. Lending and RWA protocols on Stellar read Pyth prices through it.",
  "events": [],
  "functions": [
    {
      "doc": "Upgrade the contract WASM. Callable only by the executor.",
      "name": "upgrade",
      "params": [{ "name": "new_wasm_hash", "type": { "size": 32, "type": "bytes_n" } }],
      "returns": {
        "err": { "name": "ContractError", "type": "named" },
        "ok": "void",
        "type": "result"
      }
    },
    {
      "doc": "Constructor. Stores the executor address (the Wormhole executor\ncontract authorized for governance operations).\n\nOptionally accepts an initial trusted signer and expiry. This avoids\nneeding a governance VAA for the very first signer during deployment.",
      "name": "__constructor",
      "params": [
        { "name": "executor", "type": "address" },
        {
          "name": "initial_signer",
          "type": { "inner": { "size": 33, "type": "bytes_n" }, "type": "option" }
        },
        { "name": "initial_signer_expires_at", "type": { "inner": "u64", "type": "option" } }
      ],
      "returns": {
        "err": { "name": "ContractError", "type": "named" },
        "ok": "void",
        "type": "result"
      }
    },
    {
      "doc": "Verify an LE-ECDSA signed Pyth Lazer update.\n\nParses the envelope, recovers the signer's public key, checks it against\ntrusted signers, validates expiry, and returns the verified payload bytes.\n\nVerification is stateless: it proves the payload was signed by a\ncurrently trusted signer, but does not prevent replay of an update or\norder updates by arrival. Callers must deduplicate updates and enforce\nfreshness using the `timestamp` field of the verified payload (and,\nwhere relevant, the per-feed `feed_update_timestamp`) — never the\nenvelope bytes, the signature, or a hash of either.",
      "name": "verify_update",
      "params": [{ "name": "data", "type": "bytes" }],
      "returns": {
        "err": { "name": "ContractError", "type": "named" },
        "ok": "bytes",
        "type": "result"
      }
    },
    {
      "doc": "List every currently trusted signer as `(pubkey, expires_at)` pairs.\nRead-only; readable by anyone.",
      "name": "list_trusted_signers",
      "params": [],
      "returns": {
        "item": { "elements": [{ "size": 33, "type": "bytes_n" }, "u64"], "type": "tuple" },
        "type": "vec"
      }
    },
    {
      "doc": "Add, update, or remove a trusted signer. Callable only by the executor.\nSetting `expires_at` to 0 removes the signer.",
      "name": "update_trusted_signer",
      "params": [
        { "name": "pubkey", "type": { "size": 33, "type": "bytes_n" } },
        { "name": "expires_at", "type": "u64" }
      ],
      "returns": {
        "err": { "name": "ContractError", "type": "named" },
        "ok": "void",
        "type": "result"
      }
    }
  ],
  "name": "Pyth Pro Verifier",
  "network": "mainnet",
  "types": {
    "ContractError": {
      "kind": "enum",
      "name": "ContractError",
      "variants": [
        { "discriminant": 1, "name": "AlreadyInitialized" },
        { "discriminant": 2, "name": "NotInitialized" },
        { "discriminant": 3, "name": "InvalidMagic" },
        { "discriminant": 4, "name": "TruncatedData" },
        { "discriminant": 5, "name": "InvalidPayloadLength" },
        { "discriminant": 6, "name": "SignerNotTrusted" },
        { "discriminant": 7, "name": "SignerExpired" },
        { "discriminant": 8, "name": "Unauthorized" },
        { "discriminant": 9, "name": "InvalidPayloadMagic" },
        { "discriminant": 10, "name": "InvalidChannel" },
        { "discriminant": 11, "name": "InvalidProperty" },
        { "discriminant": 12, "name": "InvalidMarketSession" },
        { "discriminant": 13, "name": "InvalidRecoveryId" }
      ]
    },
    "DataKey": {
      "cases": [
        {
          "doc": "The executor address authorized for governance operations.",
          "fields": [],
          "name": "Executor"
        },
        {
          "doc": "The full set of trusted signers, stored as a single enumerable map from\ncompressed secp256k1 pubkey to expiry timestamp (unix seconds). A single\nmap (rather than one storage entry per signer) lets the whole set be\nlisted on-chain.",
          "fields": [],
          "name": "TrustedSigners"
        }
      ],
      "kind": "union",
      "name": "DataKey"
    }
  },
  "version": "0.0.0",
