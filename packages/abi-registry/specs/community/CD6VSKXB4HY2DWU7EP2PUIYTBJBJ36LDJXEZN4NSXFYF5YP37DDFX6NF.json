{
  "contractId": "CD6VSKXB4HY2DWU7EP2PUIYTBJBJ36LDJXEZN4NSXFYF5YP37DDFX6NF",
  "description": "Axelar gateway on Stellar mainnet: the contract general message passing between Stellar and other chains goes through.",
  "events": [],
  "functions": [
    { "name": "domain_separator", "params": [], "returns": { "size": 32, "type": "bytes_n" } },
    { "name": "minimum_rotation_delay", "params": [], "returns": "u64" },
    { "name": "previous_signers_retention", "params": [], "returns": "u64" },
    {
      "name": "approve_messages",
      "params": [
        {
          "name": "messages",
          "type": { "item": { "name": "Message", "type": "named" }, "type": "vec" }
        },
        { "name": "proof", "type": { "name": "Proof", "type": "named" } }
      ],
      "returns": {
        "err": { "name": "ContractError", "type": "named" },
        "ok": "void",
        "type": "result"
      }
    },
    {
      "name": "rotate_signers",
      "params": [
        { "name": "signers", "type": { "name": "WeightedSigners", "type": "named" } },
        { "name": "proof", "type": { "name": "Proof", "type": "named" } },
        { "name": "bypass_rotation_delay", "type": "bool" }
      ],
      "returns": {
        "err": { "name": "ContractError", "type": "named" },
        "ok": "void",
        "type": "result"
      }
    },
    { "name": "epoch", "params": [], "returns": "u64" },
    {
      "name": "epoch_by_signers_hash",
      "params": [{ "name": "signers_hash", "type": { "size": 32, "type": "bytes_n" } }],
      "returns": {
        "err": { "name": "ContractError", "type": "named" },
        "ok": "u64",
        "type": "result"
      }
    },
    {
      "name": "signers_hash_by_epoch",
      "params": [{ "name": "epoch", "type": "u64" }],
      "returns": {
        "err": { "name": "ContractError", "type": "named" },
        "ok": { "size": 32, "type": "bytes_n" },
        "type": "result"
      }
    },
    {
      "name": "validate_proof",
      "params": [
        { "name": "data_hash", "type": { "size": 32, "type": "bytes_n" } },
        { "name": "proof", "type": { "name": "Proof", "type": "named" } }
      ],
      "returns": {
        "err": { "name": "ContractError", "type": "named" },
        "ok": "bool",
        "type": "result"
      }
    },
    {
      "name": "call_contract",
      "params": [
        { "name": "caller", "type": "address" },
        { "name": "destination_chain", "type": "string" },
        { "name": "destination_address", "type": "string" },
        { "name": "payload", "type": "bytes" }
      ],
      "returns": "void"
    },
    {
      "name": "is_message_approved",
      "params": [
        { "name": "source_chain", "type": "string" },
        { "name": "message_id", "type": "string" },
        { "name": "source_address", "type": "string" },
        { "name": "contract_address", "type": "address" },
        { "name": "payload_hash", "type": { "size": 32, "type": "bytes_n" } }
      ],
      "returns": "bool"
    },
    {
      "name": "is_message_executed",
      "params": [
        { "name": "source_chain", "type": "string" },
        { "name": "message_id", "type": "string" }
      ],
      "returns": "bool"
    },
    {
      "name": "validate_message",
      "params": [
        { "name": "caller", "type": "address" },
        { "name": "source_chain", "type": "string" },
        { "name": "message_id", "type": "string" },
        { "name": "source_address", "type": "string" },
        { "name": "payload_hash", "type": { "size": 32, "type": "bytes_n" } }
      ],
      "returns": "bool"
    },
    {
      "doc": "Initialize the gateway",
      "name": "__constructor",
      "params": [
        { "name": "owner", "type": "address" },
        { "name": "operator", "type": "address" },
        { "name": "domain_separator", "type": { "size": 32, "type": "bytes_n" } },
        { "name": "minimum_rotation_delay", "type": "u64" },
        { "name": "previous_signers_retention", "type": "u64" },
        {
          "name": "initial_signers",
          "type": { "item": { "name": "WeightedSigners", "type": "named" }, "type": "vec" }
        }
      ],
      "returns": {
        "err": { "name": "ContractError", "type": "named" },
        "ok": "void",
        "type": "result"
      }
    },
    { "name": "operator", "params": [], "returns": "address" },
    {
      "name": "transfer_operatorship",
      "params": [{ "name": "new_operator", "type": "address" }],
      "returns": "void"
    },
    { "name": "owner", "params": [], "returns": "address" },
    {
      "name": "transfer_ownership",
      "params": [{ "name": "new_owner", "type": "address" }],
      "returns": "void"
    },
    { "name": "paused", "params": [], "returns": "bool" },
    { "name": "pause", "params": [], "returns": "void" },
    { "name": "unpause", "params": [], "returns": "void" },
    { "name": "version", "params": [], "returns": "string" },
    { "name": "required_auths", "params": [], "returns": { "item": "address", "type": "vec" } },
    {
      "name": "upgrade",
      "params": [{ "name": "new_wasm_hash", "type": { "size": 32, "type": "bytes_n" } }],
      "returns": "void"
    },
    {
      "name": "migrate",
      "params": [
        {
          "name": "migration_data",
          "type": { "name": "__AxelarGatewayMigrationData", "type": "named" }
        }
      ],
      "returns": {
        "err": { "name": "ContractError", "type": "named" },
        "ok": "void",
        "type": "result"
      }
    }
  ],
  "name": "Axelar Gateway",
  "network": "mainnet",
  "types": {
    "CommandType": {
      "cases": [
        { "fields": [], "name": "ApproveMessages" },
        { "fields": [], "name": "RotateSigners" }
      ],
      "kind": "union",
      "name": "CommandType"
    },
    "ContractError": {
      "kind": "enum",
      "name": "ContractError",
      "variants": [
        { "discriminant": 1, "name": "MigrationNotAllowed" },
        { "discriminant": 2, "name": "InvalidThreshold" },
        { "discriminant": 3, "name": "InvalidProof" },
        { "discriminant": 4, "name": "InvalidSigners" },
        { "discriminant": 5, "name": "InsufficientRotationDelay" },
        { "discriminant": 6, "name": "InvalidSignatures" },
        { "discriminant": 7, "name": "InvalidWeight" },
        { "discriminant": 8, "name": "WeightOverflow" },
        { "discriminant": 9, "name": "NotLatestSigners" },
        { "discriminant": 10, "name": "DuplicateSigners" },
        { "discriminant": 11, "name": "InvalidSignersHash" },
        { "discriminant": 12, "name": "InvalidEpoch" },
        { "discriminant": 13, "name": "EmptySigners" },
        { "discriminant": 14, "name": "OutdatedSigners" },
        { "discriminant": 15, "name": "EmptyMessages" },
        { "discriminant": 16, "name": "ContractPaused" },
        { "discriminant": 17, "name": "InvalidMessageApproval" },
        { "discriminant": 18, "name": "MigrationInProgress" }
      ]
    },
    "Message": {
      "fields": [
        { "name": "contract_address", "type": "address" },
        { "name": "message_id", "type": "string" },
        { "name": "payload_hash", "type": { "size": 32, "type": "bytes_n" } },
        { "name": "source_address", "type": "string" },
        { "name": "source_chain", "type": "string" }
      ],
      "kind": "struct",
      "name": "Message"
    },
    "MessageApprovalKey": {
      "fields": [
        { "name": "message_id", "type": "string" },
        { "name": "source_chain", "type": "string" }
      ],
      "kind": "struct",
      "name": "MessageApprovalKey"
    },
    "MessageApprovalValue": {
      "cases": [
        {
          "fields": [{ "name": "_0", "type": { "size": 32, "type": "bytes_n" } }],
          "name": "Approved"
        },
        { "fields": [], "name": "Executed" }
      ],
      "kind": "union",
      "name": "MessageApprovalValue"
    },
    "Proof": {
      "doc": "`Proof` represents a proof that a set of signers have signed a message.\nAll weighted signers are included in the along with a signature, if they have signed the message,\nuntil threshold is met.",
      "fields": [
        { "name": "nonce", "type": { "size": 32, "type": "bytes_n" } },
        {
          "name": "signers",
          "type": { "item": { "name": "ProofSigner", "type": "named" }, "type": "vec" }
        },
        { "name": "threshold", "type": "u128" }
      ],
      "kind": "struct",
      "name": "Proof"
    },
    "ProofSignature": {
      "cases": [
        {
          "fields": [{ "name": "_0", "type": { "size": 64, "type": "bytes_n" } }],
          "name": "Signed"
        },
        { "fields": [], "name": "Unsigned" }
      ],
      "doc": "`ProofSignature` represents an optional signature from a signer.\nSince Soroban doesn't support use of `Option` in it's contract interfaces,\nwe use this enum instead.",
      "kind": "union",
      "name": "ProofSignature"
    },
    "ProofSigner": {
      "doc": "`ProofSigner` represents a signer in a proof.\n\nIf the signer submitted a signature, and if it is being included in the proof to meet the threshold,\nthen a signature is attached. Otherwise, the `ProofSignature` is `Unsigned`.",
      "fields": [
        { "name": "signature", "type": { "name": "ProofSignature", "type": "named" } },
        { "name": "signer", "type": { "name": "WeightedSigner", "type": "named" } }
      ],
      "kind": "struct",
      "name": "ProofSigner"
    },
    "Token": {
      "fields": [
        { "name": "address", "type": "address" },
        { "name": "amount", "type": "i128" }
      ],
      "kind": "struct",
      "name": "Token"
    },
    "WeightedSigner": {
      "fields": [
        { "name": "signer", "type": { "size": 32, "type": "bytes_n" } },
        { "name": "weight", "type": "u128" }
      ],
      "kind": "struct",
      "name": "WeightedSigner"
    },
    "WeightedSigners": {
      "fields": [
        { "name": "nonce", "type": { "size": 32, "type": "bytes_n" } },
        {
          "name": "signers",
          "type": { "item": { "name": "WeightedSigner", "type": "named" }, "type": "vec" }
        },
        { "name": "threshold", "type": "u128" }
      ],
      "kind": "struct",
      "name": "WeightedSigners"
    }
  },
  "version": "0.0.0",
